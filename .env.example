# .env.example
# 安全配置（生产环境必须设置）
SECRET_KEY=your-secret-key-here-change-in-production
ENVIRONMENT=development

# 初始管理员密码（可选）
# 不设置时：development 下为 admin123；production 下随机生成并在启动日志中打印一次。
# 生产环境建议显式设置，避免依赖日志中的随机密码。
# DEFAULT_ADMIN_PASSWORD=

# 基座模型名称
# Qwen3 默认开启思考模式，推理侧会显式关闭（见 audit_contract.encode_for_model），
# 否则  thinking 内容里的花括号会让 JSON 解析命中错误位置。
# 换模型时须同步训练侧的 model_name_or_path 与 template，见 training/README.md。
BASE_MODEL=Qwen/Qwen3-8B

# LoRA 适配器路径（可选）
# 留空 = 使用未经微调的基座模型，审核结果标记为 base-v1.0。
# 填了但路径不存在 = 配置错误：模型拒绝加载并回退模拟模式（记 ERROR 日志），
# 不会静默改用基座模型 —— 否则审核报告里看不出微调其实没生效。
LORA_PATH=

# 设备选择：auto, cuda, cpu
DEVICE=auto

# 模型加载到哪张 GPU：
#   - auto（默认）：自动挑选，见下面两项
#   - 具体卡号（如 "5"）：固定使用该卡
MODEL_GPU_INDEX=auto

# auto 模式下排除的卡号（逗号分隔），例如留出 0、1 号卡给其它服务
# MODEL_GPU_EXCLUDE=0,1
MODEL_GPU_EXCLUDE=

# auto 模式下要求的最小空闲显存（MiB），低于此值的卡会被跳过。
# 7B fp16 权重约 14.5GiB，加 CUDA 上下文与 KV cache 约需 16-18GiB，故下限取 18000。
# 调高更保守，但可能所有卡都不达标而无卡可用（会回退到模拟模式并记录 ERROR 日志）。
MODEL_GPU_MIN_FREE_MB=18000

# 无论哪种模式，模型都是**单卡加载**（device_map={"": <卡号>}），不会拆到多张卡。
# 无需再设 CUDA_VISIBLE_DEVICES —— 两者同时使用会让卡号变成"可见列表内的位置"，
# 容易指错卡。

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:7860,http://localhost:3000

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# 速率限制
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# 登录接口单独限流，超过后锁定 5 分钟
LOGIN_RATE_LIMIT_PER_MINUTE=5

# 上传文件大小上限（MB），超过返回 413
MAX_UPLOAD_SIZE_MB=50

# 数据库连接字符串（可选，默认使用 SQLite）
# DATABASE_URL=postgresql://user:password@localhost:5432/buildsentry

# 是否向知识库插入示例条文（仅供开箱试用）。
# 生产环境一律不插入，无论此项如何设置：示例条文会与真实规范一起参与检索、
# 带偏审核依据，并经由数据生成流进训练集。正式使用请灌入真实规范。
SEED_DEMO_DATA=true

# 条文嵌入模型。默认 BAAI/bge-small-zh-v1.5 —— 条文全是中文，
# ChromaDB 自带的 all-MiniLM-L6-v2 是英文模型，中文只能按子词匹配。
# 换成别的模型会改变向量维度，必须重建集合后重新灌库：
#   python scripts/ingest_gb_corpus.py --reset --write
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DEVICE=cpu

# 下载模型用的 HuggingFace 镜像。官方域名在部分网络环境下不可达，
# 代码里默认回退到 https://hf-mirror.com，需要覆盖时设置此项。
# HF_ENDPOINT=https://hf-mirror.com
